# Template only - never put a real password in this file (it is not gitignored).
# Copy it to .env and fill in your actual local Postgres password there.
#
# The app expects a database named "finance_agent" to already exist. Create it
# once from pgAdmin (right-click Databases -> Create -> Database), or with:
#   psql -U postgres -c "CREATE DATABASE finance_agent;"
#
# Port 5432 = PostgreSQL 17, port 5433 = PostgreSQL 18 on this machine.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5433/finance_agent

# Any long random string - used to sign login session tokens (JWT).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-string

# Cookies are marked "Secure" (HTTPS-only) when true. Keep false for local http dev.
COOKIE_SECURE=false
